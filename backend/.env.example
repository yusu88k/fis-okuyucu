# Gemini API anahtarı (https://aistudio.google.com/app/apikey adresinden alınabilir)
GEMINI_API_KEY=your_gemini_api_key_here

# Kullanılacak Gemini vision modeli (isteğe bağlı, varsayılan: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Express sunucu portu (isteğe bağlı, varsayılan: 8002)
PORT=8002

# Tek seferde yüklenebilecek maksimum fiş sayısı (varsayılan: 200, belleğe göre artırılabilir)
MAX_FILES=200

# Kimi (Moonshot AI) API anahtari (https://platform.moonshot.ai uzerinden alinir)
KIMI_API_KEY=your_kimi_api_key_here

# NVIDIA NIM API anahtari (https://build.nvidia.com - BEDAVA kota, nvapi- ile baslar)
# Tanimliysa fis okuma fallback zincirine bedava yedek olarak eklenir.
NVIDIA_API_KEY=your_nvidia_api_key_here

# NVIDIA vision modeli (org/model bicimi). Qwen2.5-VL fis/fatura OCR+JSON icin en iyisi.
# build.nvidia.com katalogundan tam model ID'sini kopyalayin.
NVIDIA_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct

# Ana model: kimi-* -> Moonshot, gemini-* -> Google, "org/model" veya "nvidia:..." -> NVIDIA NIM
AI_MODEL=kimi-k2.6

# Kontrol gerekli cikan fisler icin siradaki guclu modeller (dusunme modu acik denenir)
ESCALATION_MODELS=kimi-k3.1-pro

# 1 yapilirsa ILK okuma dahil her Kimi cagrisinda dusunme modu acilir (yavas/pahali ama titiz)
KIMI_THINKING=0

# Admin paneli sifresi (sayfada #admin ile acilir). MUTLAKA guclu bir sifre girin!
ADMIN_PASSWORD=degistir_beni_guclu_bir_sifre

# CORS: virgulle ayrilmis izinli kokenler (bos birakilirsa tum kokenlere izin verilir)
# Ornek: ALLOWED_ORIGINS=http://localhost:5600,http://192.168.1.10:5600
ALLOWED_ORIGINS=

# Maliyet tahmini fiyatlari (1M token basina USD). Bos birakilirsa varsayilanlar kullanilir.
# Ornek: AI_PRICES={"kimi-k2.6":{"in":0.15,"out":2.5}}
AI_PRICES=
