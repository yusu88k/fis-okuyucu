# Backend API adresi (lokal geliştirme)
# Platform üzerinde çalışırken bu değişken genellikle otomatik ayarlanır.
REACT_APP_BACKEND_URL=http://localhost:8002

# CRA geliştirme sunucu portu (varsayılan 3000 yerine 5600)
PORT=5600

# Uygulama giris sifresi (bos birakilirsa "test123" kullanilir)
REACT_APP_APP_PASSWORD=test123
